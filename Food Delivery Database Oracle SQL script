-- 3. CREATE TABLES
-- ============================================================


-- ============================================================
-- CUSTOMER CLUSTER TABLES
-- ============================================================


CREATE TABLE CUSTOMER
(
    CUSTOMER_ID NUMBER PRIMARY KEY,
    CUSTOMER_NAME VARCHAR2(100) NOT NULL,
    EMAIL VARCHAR2(100) UNIQUE NOT NULL,
    PHONE VARCHAR2(15) NOT NULL,
    GENDER VARCHAR2(10),
    CITY VARCHAR2(50),

    CONSTRAINT CK_CUSTOMER_GENDER
    CHECK (GENDER IN ('Male','Female','Other'))
)

CLUSTER CUSTOMER_CLUSTER
(
    CUSTOMER_ID
);


CREATE TABLE CUSTOMER_ADDRESS
(
    ADDRESS_ID NUMBER PRIMARY KEY,
    CUSTOMER_ID NUMBER NOT NULL,
    ADDRESS_LINE VARCHAR2(200) NOT NULL,
    PINCODE VARCHAR2(10) NOT NULL
)

CLUSTER CUSTOMER_CLUSTER
(
    CUSTOMER_ID
);


-- ============================================================
-- RESTAURANT CLUSTER TABLES
-- ============================================================


CREATE TABLE RESTAURANT
(
    RESTAURANT_ID NUMBER PRIMARY KEY,
    RESTAURANT_NAME VARCHAR2(100) NOT NULL,
    CITY VARCHAR2(50) NOT NULL,
    RATING NUMBER(2,1) DEFAULT 0,

    CONSTRAINT CK_RESTAURANT_RATING
    CHECK (RATING BETWEEN 0 AND 5)
)

CLUSTER RESTAURANT_CLUSTER
(
    RESTAURANT_ID
);


CREATE TABLE RESTAURANT_CATEGORY
(
    RC_ID NUMBER PRIMARY KEY,
    RESTAURANT_ID NUMBER NOT NULL,
    CATEGORY_NAME VARCHAR2(100) NOT NULL
)

CLUSTER RESTAURANT_CLUSTER
(
    RESTAURANT_ID
);


CREATE TABLE FOOD_CATEGORY
(
    CATEGORY_ID NUMBER PRIMARY KEY,
    CATEGORY_NAME VARCHAR2(100) UNIQUE NOT NULL
);


CREATE TABLE FOOD_ITEMS
(
    FOOD_ID NUMBER PRIMARY KEY,
    RESTAURANT_ID NUMBER NOT NULL,
    CATEGORY_ID NUMBER NOT NULL,
    FOOD_NAME VARCHAR2(100) NOT NULL,
    PRICE NUMBER(10,2) NOT NULL,

    CONSTRAINT CK_FOOD_PRICE
    CHECK (PRICE > 0)
)

CLUSTER RESTAURANT_CLUSTER
(
    RESTAURANT_ID
);


-- ============================================================
-- DELIVERY PARTNER CLUSTER
-- ============================================================


CREATE TABLE DELIVERY_PARTNER
(
    PARTNER_ID NUMBER PRIMARY KEY,
    PARTNER_NAME VARCHAR2(100) NOT NULL,
    PHONE VARCHAR2(15) UNIQUE NOT NULL,
    VEHICLE_TYPE VARCHAR2(20),
    RATING NUMBER(2,1) DEFAULT 0,

    CONSTRAINT CK_PARTNER_VEHICLE
    CHECK
    (
        VEHICLE_TYPE IN
        ('Bike','Scooter','Car','Bicycle')
    ),

    CONSTRAINT CK_PARTNER_RATING
    CHECK (RATING BETWEEN 0 AND 5)
)

CLUSTER DELIVERY_PARTNER_CLUSTER
(
    PARTNER_ID
);


-- ============================================================
-- ORDER CLUSTER
-- ============================================================


CREATE TABLE ORDERS
(
    ORDER_ID NUMBER PRIMARY KEY,
    CUSTOMER_ID NUMBER NOT NULL,
    RESTAURANT_ID NUMBER NOT NULL,
    PARTNER_ID NUMBER,

    ORDER_DATE DATE DEFAULT SYSDATE NOT NULL,

    TOTAL_AMOUNT NUMBER(10,2) DEFAULT 0 NOT NULL,

    ORDER_STATUS VARCHAR2(30) DEFAULT 'Pending',

    CONSTRAINT CK_ORDER_STATUS
    CHECK
    (
        ORDER_STATUS IN
        (
            'Pending',
            'Confirmed',
            'Preparing',
            'Out for Delivery',
            'Delivered',
            'Cancelled'
        )
    )
)

CLUSTER ORDER_CLUSTER
(
    ORDER_ID
);


CREATE TABLE ORDER_DETAILS
(
    ORDER_DETAIL_ID NUMBER PRIMARY KEY,
    ORDER_ID NUMBER NOT NULL,
    FOOD_ID NUMBER NOT NULL,
    QUANTITY NUMBER NOT NULL,
    PRICE NUMBER(10,2) NOT NULL,

    CONSTRAINT CK_ORDER_QUANTITY
    CHECK (QUANTITY > 0)
)

CLUSTER ORDER_CLUSTER
(
    ORDER_ID
);


CREATE TABLE PAYMENT
(
    PAYMENT_ID NUMBER PRIMARY KEY,
    ORDER_ID NUMBER UNIQUE NOT NULL,

    PAYMENT_METHOD VARCHAR2(30),

    PAYMENT_STATUS VARCHAR2(20)
    DEFAULT 'Pending',

    AMOUNT NUMBER(10,2) NOT NULL,

    CONSTRAINT CK_PAYMENT_METHOD
    CHECK
    (
        PAYMENT_METHOD IN
        (
            'Cash',
            'UPI',
            'Card',
            'Wallet',
            'Net Banking'
        )
    ),

    CONSTRAINT CK_PAYMENT_STATUS
    CHECK
    (
        PAYMENT_STATUS IN
        (
            'Pending',
            'Completed',
            'Failed',
            'Refunded'
        )
    )
)

CLUSTER ORDER_CLUSTER
(
    ORDER_ID
);


CREATE TABLE DELIVERY
(
    DELIVERY_ID NUMBER PRIMARY KEY,
    ORDER_ID NUMBER UNIQUE NOT NULL,
    PARTNER_ID NUMBER NOT NULL,

    DELIVERY_STATUS VARCHAR2(30)
    DEFAULT 'Assigned',

    CONSTRAINT CK_DELIVERY_STATUS
    CHECK
    (
        DELIVERY_STATUS IN
        (
            'Assigned',
            'Picked Up',
            'On the Way',
            'Delivered',
            'Failed'
        )
    )
)

CLUSTER ORDER_CLUSTER
(
    ORDER_ID
);


-- ============================================================
-- REVIEW CLUSTER
-- ============================================================


CREATE TABLE REVIEW
(
    REVIEW_ID NUMBER PRIMARY KEY,
    CUSTOMER_ID NUMBER NOT NULL,
    RESTAURANT_ID NUMBER NOT NULL,
    RATING NUMBER(2,1) NOT NULL,
    COMMENTS VARCHAR2(500),

    CONSTRAINT CK_REVIEW_RATING
    CHECK (RATING BETWEEN 1 AND 5)
)

CLUSTER REVIEW_CLUSTER
(
    CUSTOMER_ID
);


-- ============================================================
-- COUPON TABLE
-- ============================================================


CREATE TABLE COUPON
(
    COUPON_ID NUMBER PRIMARY KEY,
    COUPON_CODE VARCHAR2(30) UNIQUE NOT NULL,
    DISCOUNT_PERCENT NUMBER(5,2) NOT NULL,

    CONSTRAINT CK_COUPON_DISCOUNT
    CHECK (DISCOUNT_PERCENT BETWEEN 1 AND 100)
);


CREATE TABLE ORDER_COUPON
(
    OC_ID NUMBER PRIMARY KEY,
    ORDER_ID NUMBER NOT NULL,
    COUPON_ID NUMBER NOT NULL,

    CONSTRAINT UQ_ORDER_COUPON
    UNIQUE (ORDER_ID, COUPON_ID)
)

CLUSTER ORDER_CLUSTER
(
    ORDER_ID
);


-- ============================================================
-- CART CLUSTER
-- ============================================================


CREATE TABLE CART
(
    CART_ID NUMBER PRIMARY KEY,
    CUSTOMER_ID NUMBER NOT NULL,
    FOOD_ID NUMBER NOT NULL,
    QUANTITY NUMBER DEFAULT 1 NOT NULL,

    CONSTRAINT CK_CART_QUANTITY
    CHECK (QUANTITY > 0)
)

CLUSTER CART_CLUSTER
(
    CUSTOMER_ID
);


